@description "Choose one source file and report cancellation explicitly"
@require github.com/nexssp/desktop/nexssflow@v0.1.0

{
  title: "Choose a Go source or module file",
  filters: [{ name: "Go source and modules", pattern: "*.go;*.mod" }]
}
-> nexss.desktop.pick_file
-> {
  cancelled: .path == "",
  path: .path
}
